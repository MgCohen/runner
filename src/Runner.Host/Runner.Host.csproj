<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>runner-host-8f0c2d4e-5b1a-4f7e-9c3d-2a6b1e0f7d91</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Runner.Abstractions\Runner.Abstractions.csproj" />
  </ItemGroup>

  <!--
    Handler hook. If src/Runner.Handlers exists, the host references it and
    defines RUNNER_HANDLERS. Program.cs then calls services.AddHandlers(configuration)
    and scans that assembly for handlers. If the folder does not exist, the host
    builds and runs without handlers.
  -->
  <PropertyGroup Condition="Exists('..\Runner.Handlers\Runner.Handlers.csproj')">
    <DefineConstants>$(DefineConstants);RUNNER_HANDLERS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('..\Runner.Handlers\Runner.Handlers.csproj')">
    <ProjectReference Include="..\Runner.Handlers\Runner.Handlers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Runner.Host.Tests" />
  </ItemGroup>

</Project>
