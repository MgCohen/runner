<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A console-subsystem WinForms app. The process keeps the console of tray.ps1, so the logs and the
    console of the claude -p child stay in that visible window. DisableWinExeOutputInference keeps OutputType Exe.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>Runner.Tray</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Runner.Host\Runner.Host.csproj" />
    <ProjectReference Include="..\Runner.Handlers\Runner.Handlers.csproj" />
  </ItemGroup>

</Project>
