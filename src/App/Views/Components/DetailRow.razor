@* A detail row: label left, value right, min height 38. A long value is cut with … and shows in full on hover. *@
<div class="kr"><span class="k">@Label</span><span class="v ell" title="@Value">@if (ChildContent is not null) { @ChildContent } else { @Value }</span></div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public string? Value { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
