<?xml version="1.0" encoding="utf-8"?>
<!-- vendor/vsa holds the VSA packages of MgCohen/vsa-template PR 32, before its release. It needs no token. -->
<configuration>
  <packageSources>
    <clear />
    <add key="vsa-local" value="vendor/vsa" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
