@* A switch: off, on, disabled. 34 × 20 with a round knob. A click does not start a window drag. *@
<div class="sw @(On ? "on" : "") @(Disabled ? "dis" : "")" role="switch" aria-checked="@(On ? "true" : "false")" aria-disabled="@(Disabled ? "true" : "false")"
     title="@Title" tabindex="@(Disabled ? -1 : 0)" data-test="@Test" @onclick="Click" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true"
     @onkeydown="Key" @onkeydown:stopPropagation="true"></div>

@code {
    [Parameter] public bool On { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Title { get; set; }

    [Parameter] public string? Test { get; set; }

    [Parameter] public EventCallback OnToggle { get; set; }

    Task Click() => Disabled ? Task.CompletedTask : OnToggle.InvokeAsync();

    // Space or Enter toggles the switch, as a click does.
    Task Key(KeyboardEventArgs e) => e.Key is " " or "Enter" ? Click() : Task.CompletedTask;
}
