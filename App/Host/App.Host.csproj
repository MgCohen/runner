<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
    The one process of the runner (T1): the VSA modules, Kestrel on 127.0.0.1, the tray icon and the widget window.
    A Windows app: the desktop shortcut starts it with no terminal. The log goes to runner.log. The children
    (claude -p, op read) write to a visible console that the app opens while they run (VisibleConsole, T3).
    A start from a terminal (tray.ps1) uses the console of that terminal.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>App.Host</RootNamespace>
    <!-- The icon of the exe: the desktop shortcut, the Start menu and the taskbar. -->
    <ApplicationIcon>runner.ico</ApplicationIcon>
    <!-- LibraryImport for the window calls (drag, rounded corners). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The op:// references of the tokens, not the tokens. Secrets reads them in real mode. -->
    <None Include="../../deploy/runner.secrets.env" Link="runner.secrets.env" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <!-- No PrivateAssets: a test project that references the host also gets the module layers. -->
    <ProjectReference Include="../Views/App.Views.csproj" />
    <ProjectReference Include="../../Modules/*/*.csproj" />
    <PackageReference Include="VSA.Host" Version="0.1.0-preview.5" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.120" />
  </ItemGroup>
</Project>
